# Loaded by `npm run dev:u1sim` (vite --mode u1sim): the u1 app against the local stand-in for
# u1-track-manager (backend/cmd/u1sim, `docker compose --profile u1 up -d nats nats-compressed u1sim`),
# whatever .env.u1.local says about the real server. Vite proxies /u1-track-manager to
# http://localhost:8091, /nats to ws://localhost:8080 and /nats-z (compressed) to ws://localhost:8081.
# Pick the wire format in the toolbar, or with ?format=json|batch|binary&compress=1.

VITE_TRACK_BACKEND=u1
VITE_TRACK_API_BASE=/u1-track-manager
VITE_TRACK_SUBJECT_PREFIX=u1.track.region
VITE_TRACK_BATCH_PREFIX=u1.track.batch
VITE_TRACK_BINARY_PREFIX=u1.track.bin

# NATS WebSockets: empty URL = same origin /nats and /nats-z
VITE_NATS_WS_URL=
VITE_NATS_WS_URL_COMPRESSED=
VITE_NATS_USER=viewer
VITE_NATS_PASS=viewer

VITE_TRACK_INTERVAL_MS=1000
VITE_TRACK_STALE_FACTOR=3

# limits sent to POST tracks/subscriptions/resolve
VITE_MAX_PARTITIONS=36
VITE_MAX_CACHED_TRACKS=4000
