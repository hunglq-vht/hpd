# Loaded by `npm run dev:u1` / `npm run build:u1` (vite --mode u1): the app talks to
# u1-track-manager (JSON track events) instead of this repo's Go api (binary tile snapshots).
# These defaults match the local mock (`npm run mock:u1`) and the simulator (docs/U1-SIM.md, which has
# its own mode: `npm run dev:u1sim`). Put real credentials in .env.u1.local,
# which git ignores. Every VITE_* value ends up in the JS bundle, readable by anyone who loads the app.
#
# In dev, Vite proxies /u1-track-manager to $TRACK_API_URL (default http://localhost:8091, the mock)
# and /nats to $NATS_WS_URL (default ws://localhost:8080). To use a remote backend without CORS, set
# those two shell variables and keep the relative values below.

VITE_TRACK_BACKEND=u1
VITE_TRACK_API_BASE=/u1-track-manager
VITE_TRACK_SUBJECT_PREFIX=u1.track.region

# NATS WebSocket: empty URL = same origin /nats
VITE_NATS_WS_URL=
VITE_NATS_USER=viewer
VITE_NATS_PASS=viewer

# Expected publish interval until the worker has measured it; silent tracks drop after 3 intervals
VITE_TRACK_INTERVAL_MS=1000
VITE_TRACK_STALE_FACTOR=3

# limits sent to POST tracks/subscriptions/resolve
VITE_MAX_PARTITIONS=36
VITE_MAX_CACHED_TRACKS=4000
